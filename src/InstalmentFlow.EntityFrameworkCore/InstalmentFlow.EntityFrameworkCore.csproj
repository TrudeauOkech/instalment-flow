<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>PostgreSQL persistence for InstalmentFlow via EF Core: optimistic concurrency, row-level security, append-only enforcement and a transactional outbox.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstalmentFlow\InstalmentFlow.csproj" />
    <!-- The payments package (inbox, intents, provider routing tables) is referenced again when it has content (M8). -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
